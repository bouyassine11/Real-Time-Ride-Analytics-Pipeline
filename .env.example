# ============================================================
# .env.example — copy this to .env and fill in your values
# ============================================================
# The application reads these via os.getenv() in config/settings.py.
# None of these are required — sensible defaults are already set.
# ============================================================

# ------------------------------------
# Kafka
# ------------------------------------

# Broker address — Redpanda is Kafka-compatible, same port/protocol
# Use redpanda:9092 inside Docker, localhost:19092 from host machine
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092

# Topic that ride events are published to
KAFKA_TOPIC_RIDE_EVENTS=ride_events

# Dead-letter queue topic for failed/malformed messages
KAFKA_TOPIC_DLQ=ride_events_dlq

# Number of producer-level retries on send failure
KAFKA_PRODUCER_RETRIES=3

# Milliseconds between retries
KAFKA_RETRY_BACKOFF_MS=500

# Batch compression codec: none | gzip | snappy | lz4
KAFKA_COMPRESSION_TYPE=gzip

# Max bytes per request to the broker (default 1 MB)
KAFKA_MAX_REQUEST_SIZE=1048576


# ------------------------------------
# Producer / Simulator
# ------------------------------------

# Target events published per second (float allowed)
PRODUCER_EVENTS_PER_SECOND=10

# Stop after this many events (0 = run forever)
PRODUCER_MAX_EVENTS=0

# Set an integer seed to make a run fully reproducible
# Leave blank for random behaviour
PRODUCER_RANDOM_SEED=

# Minimum base fare in USD
FARE_MIN_USD=3.50

# Maximum base fare in USD
FARE_MAX_USD=85.00

# Minimum surge multiplier (1.0 = no surge)
SURGE_MIN=1.0

# Maximum surge multiplier
SURGE_MAX=3.5


# ------------------------------------
# Logging
# ------------------------------------

# Python logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
